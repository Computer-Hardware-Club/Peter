#!/usr/bin/env python3
"""Manage one event of up to four isolated Incus workshop VMs."""

import argparse
from concurrent.futures import ThreadPoolExecutor, as_completed
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import secrets
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

from workshop_templates import DEFAULT_RESOURCES, SLUG, load_template, portal_url, team_limit

HOME_DIR = Path(__file__).resolve().parent
STATE_DIR = Path("/var/lib/workshop")
STATE_FILE = STATE_DIR / "event.json"
POOL_DIR = Path("/var/lib/incus/storage-pools/workshop")
GUACD_IP = "172.31.253.4"
OWNER_KEY = "user.workshop.run"
TEAM_SLOTS = range(1, 5)
TERMINAL_PALETTE = (
    "background:rgb:10/12/16;foreground:rgb:f2/f2/ee;"
    "color0:rgb:19/1c/23;color1:rgb:f7/76/7e;color2:rgb:9e/ce/6a;"
    "color3:rgb:ff/9e/64;color4:rgb:7a/a2/f7;color5:rgb:bb/9a/f7;"
    "color6:rgb:7d/cf/da;color7:rgb:c8/d0/e0;color8:rgb:72/7b/8f;"
    "color9:rgb:ff/90/96;color10:rgb:b8/e3/88;color11:rgb:ff/b9/81;"
    "color12:rgb:a1/bb/ff;color13:rgb:d5/b5/ff;color14:rgb:a1/e9/f3;color15:rgb:f2/f2/ee"
)
FINGERPRINT = re.compile(r"[0-9a-f]{64}")


def run(*command, input_text=None, timeout=180):
    result = subprocess.run(command, input=input_text or "", capture_output=True,
                            text=True, timeout=timeout, check=True)
    return result.stdout.strip()


def incus(*args, project="workshop", **kwargs):
    return run("incus", "--force-local", "--project", project, *args, **kwargs)


def db(statement):
    try:
        return run(
            "docker", "compose", "--project-directory", str(HOME_DIR / "infra"),
            "--env-file", str(STATE_DIR / "stack.env"), "exec", "-T", "--user",
            "postgres", "db", "psql", "-XqAt", "-v", "ON_ERROR_STOP=1",
            "--dbname", "guacamole", input_text=statement, timeout=30,
        )
    except subprocess.CalledProcessError as exc:
        # PostgreSQL diagnostics can contain parts of the submitted key.
        raise RuntimeError("Guacamole database command failed. Check workshop-db-1 health.") from exc


def literal(value):
    return "'" + value.replace("'", "''") + "'"


def save(event):
    with tempfile.NamedTemporaryFile(mode="w", dir=STATE_DIR, prefix=".event-",
                                     delete=False) as output:
        try:
            json.dump(event, output)
            output.flush()
            os.fsync(output.fileno())
            os.replace(output.name, STATE_FILE)
            sync_state_directory()
        finally:
            Path(output.name).unlink(missing_ok=True)


def sync_state_directory():
    fd = os.open(STATE_DIR, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def load_event():
    try:
        return json.loads(STATE_FILE.read_text())
    except FileNotFoundError:
        return None


def guests():
    return {vm["name"]: vm for vm in json.loads(incus("list", "--format", "json"))}


def networks():
    return {net["name"]: net for net in json.loads(
        incus("network", "list", "--format", "json", project="default")
    )}


def identity(slot):
    return f"ws-team-{slot}", f"wks{slot}", f"10.241.{slot}.2", f"10.241.{slot}.1"


def team_slots(event):
    return {slot: team for slot, team in enumerate(event["teams"], 1) if team is not None}


def new_team(event, slot):
    return {
        "login": f"{event['name']}-{event['run'][:8]}-team-{slot}-{secrets.token_hex(4)}",
        "portal_login": str(slot),
        "password": secrets.token_urlsafe(24),
        "ready": False,
    }


def require_owner(resource, name, event):
    if resource and (resource.get("config") or {}).get(OWNER_KEY) != event["run"]:
        raise RuntimeError(f"Refusing to modify {name}: ownership does not match this event.")


def check_host(slots, disk_gib=DEFAULT_RESOURCES["disk_gib"]):
    run("systemctl", "is-active", "--quiet", "workshop-firewall.service")
    run("nft", "list", "table", "inet", "workshop")
    run("nft", "list", "table", "bridge", "workshop")
    free = shutil.disk_usage(POOL_DIR).free
    required_gib = 16 + disk_gib * slots
    if free < required_gib * 1024**3:
        raise RuntimeError(f"Need at least {required_gib} GiB free for VM disks and host reserve.")
    if db("SELECT count(*) FROM guacamole_system_permission;") != "0":
        raise RuntimeError("Unexpected Guacamole system permissions. Check portal administration.")


def create_bridge(slot, event):
    _, bridge, _, gateway = identity(slot)
    incus(
        "network", "create", bridge, f"ipv4.address={gateway}/30", "ipv4.nat=false",
        "ipv4.dhcp=false", "ipv4.firewall=false", "ipv6.address=none",
        "ipv6.firewall=false", "dns.mode=none", "raw.dnsmasq=port=0",
        f"{OWNER_KEY}={event['run']}",
        project="default",
    )


def create_guest(slot, event, public_key):
    name, bridge, address, gateway = identity(slot)
    user = f"team-{slot}"
    resources = event.get("resources", DEFAULT_RESOURCES)
    mac = f"02:77:6b:73:00:{slot:02x}"
    # Use a single narrow return route for SSH and no default gateway or DNS.
    network = {
        "version": 2,
        "ethernets": {"eth0": {
            "match": {"macaddress": mac}, "dhcp4": False, "dhcp6": False,
            "accept-ra": False, "link-local": [], "addresses": [f"{address}/30"],
            "routes": [{"to": f"{GUACD_IP}/32", "via": gateway}],
        }},
    }
    user_data = {
        "hostname": "peter",
        "preserve_hostname": False,
        "manage_etc_hosts": True,
        "disable_root": True,
        "ssh_pwauth": False,
        "ssh_deletekeys": True,
        "ssh_genkeytypes": ["ed25519"],
        "users": [{
            "name": user, "shell": "/bin/bash", "groups": ["sudo"],
            "sudo": ["ALL=(ALL) NOPASSWD:ALL"], "lock_passwd": True,
            "ssh_authorized_keys": [f'from="{GUACD_IP}" {public_key}'],
        }],
        "write_files": [
            {
                "path": "/etc/ssh/sshd_config.d/00-workshop.conf",
                "permissions": "0644",
                "content": f"AllowUsers {user}\nPermitRootLogin no\nDisableForwarding yes\n"
                           "HostKey /etc/ssh/ssh_host_ed25519_key\nHostKeyAlgorithms ssh-ed25519\n"
                           "PrintMotd no\nPrintLastLog no\n",
            },
            {
                "path": "/usr/local/bin/chcfetch",
                "permissions": "0755",
                "content": (HOME_DIR / "guest" / "chcfetch").read_text(),
            },
            {
                "path": "/etc/profile.d/workshop-login.sh",
                "permissions": "0644",
                "content": (HOME_DIR / "guest" / "workshop-login.sh").read_text(),
            },
        ],
        "runcmd": [["systemctl", "restart", "ssh.service"]],
    }
    if event.get("populate_home", False):
        user_data["runcmd"].insert(0, [
            "runuser", "-u", user, "--", "mkdir", "-p", "--",
            *(f"/home/{user}/{directory}" for directory in (
                "Desktop", "Documents", "Downloads", "Music", "Pictures", "Public", "Templates", "Videos",
            )),
        ])
    if script := event.get("init"):
        user_data["write_files"].append({
            "path": "/usr/local/lib/workshop/init.sh",
            "permissions": "0700",
            "content": script,
        })
        user_data["runcmd"].append([
            "/bin/bash", "-ec",
            "cd /root; /bin/bash -e /usr/local/lib/workshop/init.sh; "
            "install -d /var/lib/workshop; touch /var/lib/workshop/init-complete",
        ])
    incus(
        "init", event["image"], name, "--vm", "--profile", "workshop-vm",
        "--config", f"limits.cpu={resources['vcpus']}",
        "--config", f"limits.memory={resources['memory_mib']}MiB",
        "--config", f"{OWNER_KEY}={event['run']}",
        "--config", "cloud-init.network-config=" + json.dumps(network),
        "--config", "cloud-init.user-data=#cloud-config\n" + json.dumps(user_data),
    )
    if resources["disk_gib"] != DEFAULT_RESOURCES["disk_gib"]:
        incus("config", "device", "override", name, "root", f"size={resources['disk_gib']}GiB")
    incus("config", "device", "add", name, "eth0", "nic", f"network={bridge}",
          "name=eth0", f"hwaddr={mac}")
    incus("start", name)


def wait_for_ssh(slot, require_init=False):
    name, _, address, _ = identity(slot)
    init_check = (
        "if [ ! -f /var/lib/workshop/init-complete ]; then echo workshop-init-failed; exit 0; fi; "
        if require_init else ""
    )
    deadline = time.monotonic() + 180
    while time.monotonic() < deadline:
        try:
            output = incus(
                "exec", name, "--", "bash", "-ec",
                "test -f /var/lib/cloud/instance/boot-finished; " + init_check +
                f"sudo -n -u team-{slot} sudo -n true; "
                "test \"$(sshd -T | awk '/^hostkeyalgorithms / {print $2}')\" = ssh-ed25519; "
                "ssh-keyscan -T 2 -t ed25519 127.0.0.1 2>/dev/null",
                timeout=8,
            )
            if output == "workshop-init-failed":
                raise RuntimeError(f"{name}: init.sh failed. Check /var/log/cloud-init-output.log inside the VM.")
            keys = [line.split()[1:] for line in output.splitlines() if not line.startswith("#")]
            if len(keys) == 1 and len(keys[0]) == 2 and keys[0][0] == "ssh-ed25519":
                # From the real proxy namespace, so this checks the actual firewall path.
                run("docker", "exec", "workshop-guacd-1", "nc", "-z", "-w", "2",
                    address, "22", timeout=4)
                return f"{address} {' '.join(keys[0])}"
        except (subprocess.CalledProcessError, subprocess.TimeoutExpired):
            pass
        time.sleep(2)
    raise RuntimeError(f"{name} did not become reachable over SSH. Check its Incus console.")


def recording_identity(team):
    generation = team.get("screen_generation")
    return f"{team['login']}-r{generation}" if generation else team["login"]


def connection_name(team, status):
    return f"{team['login']}|{status}|{team['screen_generation']}"


def set_reset_status(team, status):
    return db(f"""
UPDATE guacamole_connection SET connection_name = {literal(connection_name(team, status))}
WHERE parent_id IS NULL AND split_part(connection_name, '|', 1) = {literal(team['login'])}
RETURNING connection_id;
""")


def grant_access(slot, team, ssh_key, host_key, retained=False):
    _, _, address, _ = identity(slot)
    username = literal(team.get("portal_login", team["login"]))
    connection = literal(team["login"])
    salt = secrets.token_bytes(32)
    digest = hashlib.sha256((team["password"] + salt.hex().upper()).encode()).hexdigest()
    params = {
        "hostname": address, "port": "22", "username": f"team-{slot}",
        "private-key": ssh_key, "host-key": host_key, "enable-sftp": "false",
        "server-alive-interval": "30",
        "terminal-type": "xterm-256color", "font-name": "DejaVu Sans Mono",
        "font-size": "13", "color-scheme": TERMINAL_PALETTE, "scrollback": "3000",
        "recording-path": "/recordings", "recording-name": recording_identity(team) + ".guac",
        "recording-include-keys": "false",
    }
    values = ", ".join(f"({literal(k)}, {literal(v)})" for k, v in params.items())
    if retained:
        # Keep the Guacamole account, permissions and client URL stable across a rebuild.
        previous = literal(connection_name(team, "resetting"))
        updated = db(f"""
BEGIN;
DELETE FROM guacamole_connection_parameter
WHERE connection_id IN (SELECT connection_id FROM guacamole_connection
                        WHERE parent_id IS NULL AND connection_name = {previous});
INSERT INTO guacamole_connection_parameter (connection_id, parameter_name, parameter_value)
SELECT connection_id, parameter_name, parameter_value
FROM guacamole_connection CROSS JOIN (VALUES {values}) AS p(parameter_name, parameter_value)
WHERE parent_id IS NULL AND connection_name = {previous};
UPDATE guacamole_connection SET connection_name = {literal(connection_name(team, "ready"))}
WHERE parent_id IS NULL AND connection_name = {previous}
RETURNING connection_id;
COMMIT;
""")
        if not updated:
            raise RuntimeError("The portal connection disappeared during the VM reset.")
        return
    db(f"""
BEGIN;
INSERT INTO guacamole_entity (name, type) VALUES ({username}, 'USER');
INSERT INTO guacamole_user (entity_id, password_hash, password_salt, password_date)
SELECT entity_id, decode('{digest}', 'hex'), decode('{salt.hex()}', 'hex'), now()
FROM guacamole_entity WHERE name = {username} AND type = 'USER';
INSERT INTO guacamole_connection (connection_name, protocol, max_connections, max_connections_per_user)
VALUES ({connection}, 'ssh', 1, 1);
INSERT INTO guacamole_connection_parameter (connection_id, parameter_name, parameter_value)
SELECT connection_id, parameter_name, parameter_value
FROM guacamole_connection CROSS JOIN (VALUES {values}) AS p(parameter_name, parameter_value)
WHERE connection_name = {connection} AND parent_id IS NULL;
INSERT INTO guacamole_connection_permission (entity_id, connection_id, permission)
SELECT entity_id, connection_id, 'READ' FROM guacamole_entity CROSS JOIN guacamole_connection
WHERE name = {username} AND type = 'USER' AND connection_name = {connection} AND parent_id IS NULL;
COMMIT;
""")


def revoke_access(teams):
    users = ", ".join(literal(team.get("portal_login", team["login"])) for team in teams)
    connections = ", ".join(literal(team["login"]) for team in teams)
    db(f"""
BEGIN;
DELETE FROM guacamole_entity WHERE type = 'USER' AND name IN ({users});
DELETE FROM guacamole_connection WHERE parent_id IS NULL AND split_part(connection_name, '|', 1) IN ({connections});
COMMIT;
""")


def provision_team(slot, event, key, replacing):
    name, bridge, _, _ = identity(slot)
    print(f"Starting {name}", flush=True)
    existing_bridge = networks().get(bridge)
    require_owner(existing_bridge, bridge, event)
    team = event["teams"][slot - 1]
    retained = False
    if replacing:
        current = guests()
        require_owner(current.get(name), name, event)
        if team.get("resetting"):
            retained = bool(set_reset_status(team, "resetting"))
        else:
            revoke_access([team])
        remove_guest(slot, event, current)
    if not existing_bridge:
        create_bridge(slot, event)
    run("ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-f", str(key))
    create_guest(slot, event, key.with_suffix(".pub").read_text().strip())
    host_key = wait_for_ssh(slot, require_init=bool(event.get("init")))
    grant_access(slot, team, key.read_text(), host_key, retained)


def provision(event, slots, replacing=False):
    # Only the parent thread writes state. Persist intent before touching resources.
    for slot in slots:
        event["teams"][slot - 1].pop("error", None)
    save(event)
    failed = []
    with tempfile.TemporaryDirectory(prefix="workshop-keys-", dir="/run") as tmp:
        with ThreadPoolExecutor(max_workers=len(slots)) as pool:
            work = {pool.submit(provision_team, slot, event, Path(tmp) / str(slot), replacing): slot
                    for slot in slots}
            for future in as_completed(work):
                slot = work[future]
                team = event["teams"][slot - 1]
                try:
                    future.result()
                except (RuntimeError, OSError, subprocess.SubprocessError) as error:
                    failed.append(slot)
                    team["error"] = (str(error) if isinstance(error, RuntimeError)
                                     else "Peter could not prepare this VM. Check its Incus status.")
                    if team.get("resetting"):
                        try:
                            set_reset_status(team, "failed")
                        except (RuntimeError, OSError, subprocess.SubprocessError):
                            print(f"Team {slot}: Could not report the reset failure to the portal.",
                                  file=sys.stderr, flush=True)
                    print(f"Team {slot}: {team['error']}", file=sys.stderr, flush=True)
                else:
                    team["ready"] = True
                    print(f"{identity(slot)[0]} is ready", flush=True)
                team.pop("resetting", None)
                save(event)
    if failed:
        numbers = ", ".join(str(slot) for slot in sorted(failed))
        raise RuntimeError(f"Could not prepare team(s) {numbers}. Retry those teams individually.")


def check_available(slots, resources):
    check_host(len(slots), resources["disk_gib"])
    existing_guests, existing_networks = guests(), networks()
    for slot in slots:
        name, bridge, _, _ = identity(slot)
        if name in existing_guests or bridge in existing_networks:
            raise RuntimeError(f"Reserved name {name} or {bridge} is already in use.")


def validated_template(name):
    template = load_template(HOME_DIR / "templates", name)
    if template["init"]:
        run("bash", "-n", input_text=template["init"], timeout=5)
    return template


def require_team_capacity(count, resources):
    limit = team_limit(resources)
    if count > limit:
        raise RuntimeError(f"These VM resources allow at most {limit} team(s) within the project limits.")


def deploy(args):
    if load_event():
        raise RuntimeError("An event already exists. Use add, status, reset, or destroy.")
    if not SLUG.fullmatch(args.name) or not SLUG.fullmatch(args.template):
        raise RuntimeError("Event and template names must be lowercase slugs of up to 24 characters.")
    template = validated_template(args.template)
    resources = template["resources"]
    require_team_capacity(args.teams, resources)
    image = next((
        item["fingerprint"] for item in json.loads(incus("image", "list", "--format", "json"))
        if item["type"] == "virtual-machine"
        and any(alias["name"] == template["image"] for alias in item["aliases"] or [])
    ), "")
    if not FINGERPRINT.fullmatch(image):
        raise RuntimeError(f"Template image {template['image']} is not installed. "
                           "Build a package template with sudo workshop build-template NAME.")
    slots = range(1, args.teams + 1)
    check_available(slots, resources)
    event = {
        "name": args.name, "run": secrets.token_hex(8), "template": args.template, "image": image,
        "resources": resources, "init": template["init"],
        "populate_home": template["populate_home"],
    }
    event["teams"] = [new_team(event, slot) for slot in slots]
    provision(event, slots)


def add_team(event):
    current = team_slots(event)
    resources = event.get("resources", DEFAULT_RESOURCES)
    require_team_capacity(len(current) + 1, resources)
    slot = next((slot for slot in TEAM_SLOTS if slot not in current), None)
    if slot is None:
        raise RuntimeError("This event already has four teams.")
    check_available([slot], resources)
    if slot > len(event["teams"]):
        event["teams"].append(new_team(event, slot))
    else:
        event["teams"][slot - 1] = new_team(event, slot)
    provision(event, [slot])


def remove_guest(slot, event, current):
    name, _, _, _ = identity(slot)
    vm = current.get(name)
    require_owner(vm, name, event)
    if vm:
        incus("delete", name, "--force")


def owned_resources(event, slots):
    current, bridges = guests(), networks()
    for slot in slots:
        name, bridge, _, _ = identity(slot)
        require_owner(current.get(name), name, event)
        require_owner(bridges.get(bridge), bridge, event)
    return current, bridges


def reset(event, slot, keep_password=True):
    active = team_slots(event)
    slots = [slot] if slot else list(active)
    if not slots:
        raise RuntimeError("There are no teams to reset. Add a team first.")
    check_host(len(slots), event.get("resources", DEFAULT_RESOURCES)["disk_gib"])
    teams = [active[number] for number in slots]
    for team in teams:
        team["ready"] = False
        team["screen_generation"] = secrets.token_hex(6)
        team["resetting"] = keep_password
        if not keep_password:
            team["password"] = secrets.token_urlsafe(24)
    provision(event, slots, replacing=True)


def remove_teams(event, slots):
    if not slots:
        return
    current, bridges = owned_resources(event, slots)
    teams = [event["teams"][slot - 1] for slot in slots]
    for team in teams:
        team["ready"] = False
    save(event)
    revoke_access(teams)
    for slot in slots:
        _, bridge, _, _ = identity(slot)
        remove_guest(slot, event, current)
        if bridge in bridges:
            incus("network", "delete", bridge, project="default")
    users = ", ".join(literal(team.get("portal_login", team["login"])) for team in teams)
    connections = ", ".join(literal(team["login"]) for team in teams)
    db(f"""
BEGIN;
DELETE FROM guacamole_user_history WHERE username IN ({users});
DELETE FROM guacamole_connection_history WHERE split_part(connection_name, '|', 1) IN ({connections});
COMMIT;
""")
    clear_recordings(teams)
    for slot in slots:
        event["teams"][slot - 1] = None
    save(event)


def clear_recordings(teams):
    logins = "|".join(re.escape(team["login"]) for team in teams)
    filenames = re.compile(rf"(?:{logins})(?:-r[0-9a-f]{{12}})?(?:\.guac)?(?:\.\d+)?(?:\.timing)?")
    for volume in ("workshop_screens", "workshop_recordings"):
        try:
            mountpoint = run("docker", "volume", "inspect", "--format", "{{.Mountpoint}}", volume, timeout=10)
        except subprocess.CalledProcessError:
            continue
        for entry in Path(mountpoint).iterdir():
            if filenames.fullmatch(entry.name):
                entry.unlink(missing_ok=True)


def destroy(event):
    remove_teams(event, list(team_slots(event)))
    STATE_FILE.unlink()
    sync_state_directory()
    print("Workshop event destroyed.")


def status(event):
    try:
        with urllib.request.urlopen("http://127.0.0.1:8080/", timeout=3) as portal:
            print(f"Portal HTTP {portal.status}")
    except (urllib.error.URLError, TimeoutError):
        print("Portal unavailable")
    if not event:
        print("No workshop event.")
        return
    print(f"{event['name']} | {event['template']} | image {event['image'][:12]}")
    current = guests()
    for slot, team in team_slots(event).items():
        name, _, address, _ = identity(slot)
        state = current.get(name, {}).get("status", "Missing")
        access = "ready" if team["ready"] else "needs retry" if team.get("error") else "pending"
        print(f"Team {slot}: {name} {address} {state} | portal {access}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="action", required=True)
    new = commands.add_parser("deploy")
    new.add_argument("name")
    new.add_argument("--template", default="test-vm")
    new.add_argument("--teams", type=int, choices=TEAM_SLOTS, required=True)
    commands.add_parser("add").add_argument("--expect-run", help=argparse.SUPPRESS)
    removal = commands.add_parser("remove")
    removal.add_argument("--team", type=int, choices=TEAM_SLOTS, required=True)
    removal.add_argument("--yes", action="store_true", required=True)
    removal.add_argument("--expect-login", help=argparse.SUPPRESS)
    commands.add_parser("status", aliases=["list"])
    teardown = commands.add_parser("destroy")
    teardown.add_argument("--yes", action="store_true", required=True)
    teardown.add_argument("--expect-run", help=argparse.SUPPRESS)
    replacement = commands.add_parser("reset")
    selection = replacement.add_mutually_exclusive_group(required=True)
    selection.add_argument("--team", type=int, choices=TEAM_SLOTS)
    selection.add_argument("--all", action="store_true")
    replacement.add_argument("--yes", action="store_true", required=True)
    passwords = replacement.add_mutually_exclusive_group()
    passwords.add_argument("--keep-password", dest="keep_password", action="store_true", default=True)
    passwords.add_argument("--rotate-password", dest="keep_password", action="store_false")
    replacement.add_argument("--expect-login", help=argparse.SUPPRESS)
    commands.add_parser("credentials").add_argument("--team", type=int, choices=TEAM_SLOTS,
                                                    required=True)
    commands.add_parser("validate-template").add_argument("template")
    commands.add_parser("build-template").add_argument("template")
    args = parser.parse_args()
    if args.action == "validate-template":
        template = validated_template(args.template)
        print(f"{args.template}: valid template; image {template['image']}; "
              f"up to {team_limit(template['resources'])} team(s)")
        return
    if os.geteuid() != 0:
        parser.error("run workshop with sudo on Peter")
    os.umask(0o077)
    if args.action == "build-template":
        template = validated_template(args.template)
        if not template["packages"]:
            raise ValueError(f"Template {args.template} declares no packages to build.")
        result = subprocess.run([str(HOME_DIR / "build-template.sh"), template["image"],
                                 *template["packages"]])
        sys.exit(result.returncode)
    if args.action in {"status", "list"}:
        status(load_event())
        return
    with (STATE_DIR / "lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        event = load_event()
        expected_run = getattr(args, "expect_run", None)
        if expected_run is not None and (not event or event["run"] != expected_run):
            raise RuntimeError("The workshop changed. Refresh the dashboard and try again.")
        expected_login = getattr(args, "expect_login", None)
        if expected_login is not None:
            team = team_slots(event).get(args.team) if event else None
            if not team or team["login"] != expected_login:
                raise RuntimeError("That team changed. Refresh the dashboard and try again.")
        if args.action == "deploy":
            deploy(args)
        elif not event:
            if args.action == "destroy":
                print("No workshop event.")
            else:
                raise RuntimeError("No workshop event.")
        elif getattr(args, "team", None) and args.team not in team_slots(event):
            raise RuntimeError("That team does not exist in this event.")
        elif args.action == "add":
            add_team(event)
        elif args.action == "remove":
            remove_teams(event, [args.team])
            print(f"Team {args.team} removed.")
        elif args.action == "reset":
            reset(event, args.team, args.keep_password)
        elif args.action == "destroy":
            destroy(event)
        else:
            team = event["teams"][args.team - 1]
            if not team["ready"]:
                raise RuntimeError("That team's portal access is pending. Check status or reset.")
            print(f"URL: {portal_url()}\nUsername: {team.get('portal_login', team['login'])}\nPassword: {team['password']}")


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        print(f"workshop: {error.stderr.strip() or error.cmd[0] + ' command failed'}",
              file=sys.stderr)
        sys.exit(1)
    except (RuntimeError, OSError, ValueError, subprocess.TimeoutExpired) as error:
        print(f"workshop: {error}", file=sys.stderr)
        sys.exit(1)
